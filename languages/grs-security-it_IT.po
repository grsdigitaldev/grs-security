#: includes/admin/class-admin.php:290
msgid "%d fix applied."
msgid_plural "%d fixes applied."
msgstr[0] "%d correzione applicata."
msgstr[1] "%d correzioni applicate."

#: includes/admin/class-admin.php:370
msgid ""
"Invalid login address: use at least 4 characters (letters, numbers, hyphens)"
" and avoid words such as login, admin, dashboard."
msgstr ""
"Indirizzo di login non valido: usa almeno 4 caratteri (lettere, numeri, "
"trattini) ed evita parole come login, admin, dashboard."

#: includes/admin/class-admin.php:372
msgid "To move the login page, enter the new address."
msgstr "Per spostare il login indica il nuovo indirizzo."

#: includes/admin/class-admin.php:375
msgid "A page with this address already exists: choose another one."
msgstr "Esiste già una pagina con questo indirizzo: scegline un altro."

#: includes/admin/class-admin.php:405
msgid "Settings saved."
msgstr "Impostazioni salvate."

#. translators: %s: URL
#: includes/admin/class-admin.php:410
msgid ""
"From now on the login page is %s: bookmark it. The new address has also been"
" sent by email."
msgstr ""
"Da ora la pagina di accesso è %s: salvala nei preferiti. Il nuovo indirizzo "
"è stato inviato anche via email."

#: includes/admin/class-admin.php:429
msgid ""
"Check started: it continues in the background, reload the page in a few "
"minutes."
msgstr ""
"Controllo avviato: prosegue in background, ricarica la pagina tra qualche "
"minuto."

